<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <id>com.github.maxsg5.tablad</id>
    <name>TabLad</name>
    <vendor>maxsg5</vendor>
    <description><![CDATA[
        <p>Adds a <b>Tabs by Project</b> tool window to JetBrains Rider that lists open editor tabs
        grouped by their owning .NET project, with auto-assigned per-project colors and live
        error / warning indicators driven by Rider's analyzer.</p>
        <p>Inspired by Visual Studio's per-project tab grouping; complements but does not replace
        the native editor tab bar.</p>
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.rider</depends>

    <resource-bundle>messages.MyBundle</resource-bundle>

    <extensions defaultExtensionNs="com.intellij">
        <toolWindow
                id="TabLad"
                anchor="right"
                icon="AllIcons.Toolwindows.ToolWindowProject"
                factoryClass="com.github.maxsg5.tablad.toolWindow.MyToolWindowFactory"/>
        <projectConfigurable
                groupId="appearance"
                id="com.tabsbyproject.settings"
                displayName="TabLad Config"
                instance="com.github.maxsg5.tablad.Config"/>
    </extensions>
</idea-plugin>
